# SentinelBurn AI - Example environment variables
# Copy to .env and fill values for local development or CI

# Server (backend) settings
PORT=
JWT_SECRET=
CLIENT_URL=
DATABASE_URL=
REDIS_URL=
MQTT_BROKER_URL=
ML_SERVICE_URL=
SIMULATOR_URL=
SIM_DEFAULT_DEVICE_COUNT=
SIM_DEFAULT_ANOMALY_RATE=
SIM_DEFAULT_SPEED_MULTIPLIER=

# Render-specific / deployment
NODE_ENV=production

# Gemini Live / real-time AI (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Vite frontend envs (prefix with VITE_)
VITE_API_URL=
VITE_SOCKET_URL=

# Example: For local dev you might set
# VITE_API_URL=http://localhost:4000
# VITE_SOCKET_URL=http://localhost:4000
# SentinelBurn AI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to GitHub.

# ─── Backend Server ────────────────────────────────────────────────
PORT=4000
JWT_SECRET=your_super_secure_jwt_secret_here_min_32_chars

# Frontend URL (used for CORS) — set to your Vercel URL in production
CLIENT_URL=http://localhost:5173

# ─── ML Microservice ───────────────────────────────────────────────
# Local: http://localhost:8000
# Production: https://sentinelburn-ml.onrender.com
ML_SERVICE_URL=http://localhost:8000

# ─── Simulator ─────────────────────────────────────────────────────
SIMULATOR_URL=http://localhost:8001
SIM_DEFAULT_DEVICE_COUNT=200
SIM_DEFAULT_ANOMALY_RATE=0.05
SIM_DEFAULT_SPEED_MULTIPLIER=60

# ─── Frontend (Vite env vars — prefix with VITE_) ──────────────────
# Local: http://localhost:4000
# Production: https://sentinelburn-backend.onrender.com
VITE_API_URL=http://localhost:4000
